generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADVISOR
  ADMIN
}

enum ChatType {
  GLOBAL_ADVISOR
  USER_ADVISOR
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  role        Role    @default(USER)
  verified    Boolean @default(false)
  verifyToken String?

  // 🔗 Relation conseiller
  advisorId String?
  advisor   User?   @relation("UserAdvisor", fields: [advisorId], references: [id])

  // 🔗 Relation clients
  clients User[] @relation("UserAdvisor")

  // 🔗 Chat relations
  chat         Chat?     @relation("UserChat")
  sentMessages Message[] @relation("MessageSender")

  // 🔗 Notifications
  notifications Notification[]

  // 🔗 News
  news News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Chat {
  id        String    @id @default(cuid())
  type      ChatType
  userId    String?   @unique // Pour USER_ADVISOR: le user (pas l'advisor)
  user      User?     @relation("UserChat", fields: [userId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())

  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  createdAt DateTime @default(now())

  @@map("messages")
}

model Notification {
  id        String   @id @default(cuid())
  content   String
  read      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("notifications")
}

model News {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  @@map("news")
}
