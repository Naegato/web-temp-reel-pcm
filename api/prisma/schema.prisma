// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADVISOR
}

enum ChatStatus {
  WAITING
  IN_PROGRESS
  CLOSED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  password  String
  role      Role     @default(CLIENT)
  firstname String   @db.VarChar(100)
  lastname  String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clientChats  Chat[]    @relation("ClientChats")
  advisorChats Chat[]    @relation("AdvisorChats")
  messages     Message[]

  @@index([role, isActive])
  @@map("users")
}

model Chat {
  id        String     @id @default(uuid())
  status    ChatStatus @default(WAITING)
  createdAt DateTime   @default(now())
  takenAt   DateTime?
  closedAt  DateTime?

  // Relations
  clientId  String
  advisorId String?

  client User @relation("ClientChats", fields: [clientId], references: [id], onDelete: Restrict)

  advisor User? @relation("AdvisorChats", fields: [advisorId], references: [id], onDelete: Restrict)

  messages Message[]

  @@index([status, createdAt])
  @@index([clientId])
  @@index([advisorId, status])
  @@map("chats")
}

model Message {
  id      String   @id @default(uuid())
  content String   @db.Text
  sentAt  DateTime @default(now())

  chatId   String
  authorId String

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([chatId, sentAt])
  @@index([authorId])
  @@map("messages")
}
