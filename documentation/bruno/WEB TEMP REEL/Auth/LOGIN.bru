meta {
  name: LOGIN
  type: http
  seq: 1
}

post {
  url: {{api_url}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test@test.test",
    "password": "strongPassword123!"
  }
}

script:post-response {
  const body = res.getBody();
  const token = body?.access_token || null
  
  bru.setEnvVar('token', token)
}

settings {
  encodeUrl: true
  timeout: 0
}
